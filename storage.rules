rules_version = '2';

// Deny-by-default skeleton. Phase 3/5 (PLAN.md section 4) fills in real
// rules:
//   - billboards/{billboardId}/**: writable only by the owning rentor.
//   - bookings/{bookingId}/creative/**: writable only by the requesting renter.
//   - both publicly readable when the parent Firestore doc is public.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
