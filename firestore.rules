rules_version = '2';

// Deny-by-default skeleton. Phase 2+ (PLAN.md section 4, "Security Model")
// fills in the real per-collection rules:
//   - users:      read/update own profile only; `role` not client-writable.
//   - billboards: public read where status == 'active'; write restricted to
//                 the owning rentor (request.auth.token.role == 'rentor' &&
//                 resource.data.ownerId == request.auth.uid).
//   - bookings:   status transitions happen via Cloud Functions callables
//                 (requestBooking / respondToBooking), not direct client
//                 writes — client writes to `bookings` should stay closed.
//   - payments:   written only by Cloud Functions (Stripe webhook / admin SDK).
//   - categories / sizes: public read, admin-only write.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
